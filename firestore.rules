rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Toda escritura exige la sesión anónima que el juego abre al iniciar
    function isAuthenticated() {
      return request.auth != null;
    }

    function textoCorto(campo, max) {
      return campo is string && campo.size() > 0 && campo.size() <= max;
    }

    // Límite general para colecciones cuyo formato aún no está definido
    function documentoAcotado() {
      return request.resource.data.size() <= 20;
    }

    // Bitácora de Telemetría (eventos del juego)
    // Formato de src/services/telemetria.js; lectura solo desde la consola de Firebase
    match /eventos/{documento} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['id', 'sessionId', 'timestamp', 'fechaIso', 'tipo', 'escena', 'datos'])
        && textoCorto(request.resource.data.sessionId, 64)
        && textoCorto(request.resource.data.tipo, 64)
        && textoCorto(request.resource.data.escena, 64)
        && request.resource.data.timestamp is int
        && request.resource.data.datos is map
        && request.resource.data.datos.size() <= 30;
      allow read, update, delete: if false;
    }

    // Progreso de partida (un documento por sesión anónima)
    match /progreso/{sessionId} {
      allow read, write: if isAuthenticated() && request.auth.uid == sessionId;
    }

    // Tabla de puntajes (anónima)
    match /puntajes/{puntajeId} {
      allow read: if true;
      allow create: if isAuthenticated() && documentoAcotado();
      allow update, delete: if false;
    }

    // Evaluaciones Pre-test y Post-test
    match /tests/{testId} {
      allow create: if isAuthenticated() && documentoAcotado();
      allow read, update, delete: if false;
    }

    // Formulario de comentarios y retroalimentación docente
    match /comentarios/{comentarioId} {
      allow create: if isAuthenticated() && documentoAcotado();
      allow read, update, delete: if false;
    }
  }
}
